# =============================================================================
# BornoLand — production / Docker Compose environment template
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production with secrets.
# =============================================================================

NODE_ENV=production

# Which env file Compose should load (optional override)
# ENV_FILE=.env.production

# Host port mappings (EC2 security group / Nginx will front these)
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4000

# ── Public URLs (browser-facing) ─────────────────────────────────────────────
# Local Docker:
APP_NAME=BornoLand
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BornoLand
NEXT_PUBLIC_ASSET_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_SUBDOMAIN=true
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BUILDER=true

# Platform apex (IP / localhost) → this storefront slug. Required on EC2 when
# browsing by public IP (e.g. http://3.111.51.117:3000). Never hardcode in code.
# Rebuild frontend after changing NEXT_PUBLIC_* values.
NEXT_PUBLIC_DEFAULT_TENANT=
# Optional extra platform hosts (bare IPs are detected automatically):
# NEXT_PUBLIC_PLATFORM_HOSTS=3.111.51.117

# Browser calls same-origin /api → Next.js rewrites to the backend container.
NEXT_PUBLIC_API_URL=/api

# Server-side rewrite / SSR → Docker Compose service name (NOT localhost)
API_URL=http://backend:4000

# EC2 Production example (uncomment or copy to .env.production):
# APP_URL=http://3.111.51.117:3000
# WEB_URL=http://3.111.51.117:3000
# NEXT_PUBLIC_PROTOCOL=http
# NEXT_PUBLIC_ROOT_DOMAIN=3.111.51.117:3000
# NEXT_PUBLIC_APP_URL=http://3.111.51.117:3000
# NEXT_PUBLIC_ASSET_URL=http://3.111.51.117:3000
# NEXT_PUBLIC_SOCKET_URL=http://3.111.51.117:3000
# NEXT_PUBLIC_API_URL=/api
# CORS_ORIGINS=http://3.111.51.117:3000
# ROOT_DOMAIN=3.111.51.117:3000
# WILDCARD_DOMAIN=.your-root.tld
# COOKIE_SECURE=true

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGINS=http://localhost:3000
ROOT_DOMAIN=localhost:3000
WILDCARD_DOMAIN=
SESSION_COOKIE_NAME=bornoland.session

# MongoDB Atlas (REQUIRED) — do NOT use a local Mongo Docker container
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=bornoland
MONGODB_DB=bornoland

# Auth (REQUIRED in production — use long random secrets)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BornoLand <no-reply@example.com>"

# Media / payments (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

# Redis (optional — leave empty if unused)
REDIS_URL=
REDIS_TOKEN=
