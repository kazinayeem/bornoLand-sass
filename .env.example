NODE_ENV=development
APP_NAME=BornoLand

# App URLs (development)
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_PROTOCOL=http

# API
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Server-side domain (API subdomain routing + cookies)
ROOT_DOMAIN=localhost:3000
WILDCARD_DOMAIN=

MONGODB_URI=
MONGODB_DB=bornoland

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BornoLand <no-reply@example.com>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

REDIS_URL=
REDIS_TOKEN=
SESSION_COOKIE_NAME=bornoland.session
NEXT_PUBLIC_APP_NAME=BornoLand

# Production example (copy to .env.production or hosting env)
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_ROOT_DOMAIN=bornosoft.site
# NEXT_PUBLIC_PROTOCOL=https
# APP_URL=https://bornosoft.site
# WEB_URL=https://bornosoft.site
# API_URL=https://api.bornosoft.site
# NEXT_PUBLIC_API_URL=https://api.bornosoft.site
# ROOT_DOMAIN=bornosoft.site
# WILDCARD_DOMAIN=.bornosoft.site
