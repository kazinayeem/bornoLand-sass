# =============================================================================
# apps/api/.env.production  —  Production environment configuration
# Loaded by dotenv-flow when NODE_ENV=production (after .env).
# Values here OVERRIDE .env defaults.
#
# NEVER commit this file — it contains production secrets.
# See .env.example for the template.
# =============================================================================

NODE_ENV=production
PORT=4000

# Public-facing API URL (used for webhooks, callbacks, IPN in production)
API_URL=https://api.bornosoft.site
API_PUBLIC_URL=https://api.bornosoft.site

# Frontend URLs
APP_URL=https://bornosoft.site
WEB_URL=https://bornosoft.site
ROOT_DOMAIN=bornosoft.site
NEXT_PUBLIC_ROOT_DOMAIN=bornosoft.site

# CORS — allow production frontend origin, subdomains, and direct IP testing
CORS_ORIGINS=https://bornosoft.site,https://www.bornosoft.site,http://3.111.51.117:3000

# MongoDB Atlas (REQUIRED — do NOT use a local Mongo container in production)
MONGODB_URI=mongodb+srv://miahnayeem470_db_user:zWeSH0PUn3OZ2y4Q@cluster0.va8kngs.mongodb.net/?appName=Cluster0
MONGODB_DB=bornoland

# Auth secrets — use long random strings (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://3.111.51.117:4000/auth/google/callback

# Email (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BornoLand <no-reply@example.com>"

# Media / payments (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

# Redis (optional — leave empty if unused)
REDIS_URL=
REDIS_TOKEN=

# AI Shop Builder
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://api.agentrouter.org/v1
AGENT_ROUTER_MODEL=anthropic/claude-3.5-sonnet

# Cache revalidation secret — set a strong random value
REVALIDATE_SECRET=change-me-revalidate-secret
