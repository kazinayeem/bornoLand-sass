NODE_ENV=development
APP_NAME=BornoLand

# App URLs (development)
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_PROTOCOL=http

# When visiting platform apex hosts (loopback / bare IP), optionally rewrite to this
# storefront slug. Leave empty when ROOT_DOMAIN is a real marketing site.
# NEXT_PUBLIC_DEFAULT_TENANT=
# Optional extra wildcard bases (comma-separated), e.g. temporary IP DNS suffixes:
# NEXT_PUBLIC_PLATFORM_BASES=13.201.93.77.nip.io

# API
# Local `pnpm dev`: point at the API directly (or use /api with next rewrite).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Server-side domain (API subdomain routing + cookies)
ROOT_DOMAIN=localhost:3000
WILDCARD_DOMAIN=

MONGODB_URI=
MONGODB_DB=bornoland

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption key for sensitive data (SMTP passwords, etc.) - generate with: openssl rand -hex 32
ENCRYPTION_KEY=testtest

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BornoLand <no-reply@example.com>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

REDIS_URL=
REDIS_TOKEN=
SESSION_COOKIE_NAME=bornoland.session
NEXT_PUBLIC_APP_NAME=BornoLand

# ── Docker / production ──────────────────────────────────────────────────────
# Copy `.env.production.example` → `.env.production` for Compose.
# In Docker Compose:
#   NEXT_PUBLIC_API_URL=/api
#   API_URL=http://backend:4000          # container DNS name (NOT localhost)
#   MONGODB_URI=mongodb+srv://...        # MongoDB Atlas only (no Mongo container)
#
# Commands:
#   pnpm docker:build
#   pnpm docker:up
#   pnpm docker:logs
#   pnpm docker:down
#
# Or:
#   docker compose --env-file .env.production build
#   docker compose --env-file .env.production up -d

# Production example (copy to .env.production or hosting env)
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_ROOT_DOMAIN=bornosoft.site
# NEXT_PUBLIC_PROTOCOL=https
# APP_URL=https://bornosoft.site
# WEB_URL=https://bornosoft.site
# API_URL=https://api.bornosoft.site
# NEXT_PUBLIC_API_URL=https://api.bornosoft.site
# ROOT_DOMAIN=bornosoft.site
# WILDCARD_DOMAIN=.bornosoft.site
