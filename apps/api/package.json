{
  "name": "@bornoland/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean --no-splitting",
    "start": "NODE_ENV=production node dist/index.js",
    "seed": "tsx src/seed/cli.ts",
    "seed:products": "tsx src/seed/nayeem-products.cli.ts",
    "seed:nayeem": "tsx src/scripts/seed-nayeem-store.ts",
    "seed:nayeem-products": "tsx ../../scripts/seed-nayeem-products.ts",
    "migrate": "tsx src/bootstrap/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",

    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.19.1",
    "pino": "^9.8.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.2",
    "sslcommerz-lts": "^1.2.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv-flow": "^3.3.3",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}