# =============================================================================
# apps/api/.env.example  —  Example environment file for Express backend
# Copy to .env.local for local development, or .env.production for production:
#   cp .env.example .env.local
#
# DO NOT put real secrets in this file.
# =============================================================================

# Runtime environment (development | production)
NODE_ENV=development

# Server port (default 4000)
PORT=4000

# Backend public URLs
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Frontend application URLs
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Root domain
ROOT_DOMAIN=localhost:3000

# Database — MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=bornoland
MONGODB_DB=bornoland

# Authentication secrets (use openssl rand -hex 32 for production)
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=your-encryption-key-here
SESSION_COOKIE_NAME=bornoland.session

# OAuth (Google) - Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# SMTP / Email - Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BornoLand <no-reply@example.com>"

# Cloudinary - Optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateways - Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

# Redis Cache - Optional
REDIS_URL=
REDIS_TOKEN=

# AI Shop Builder - Optional
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://api.agentrouter.org/v1
AGENT_ROUTER_MODEL=anthropic/claude-3.5-sonnet

# Next.js on-demand ISR revalidation secret
REVALIDATE_SECRET=your-revalidate-secret
