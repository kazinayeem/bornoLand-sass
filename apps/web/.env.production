# =============================================================================
# apps/web/.env.production  —  Production environment configuration
# Loaded by Next.js in production (after .env).
# Values here OVERRIDE .env defaults.
#
# Production domain: bornosoft.site
# =============================================================================

NEXT_PUBLIC_APP_ENV=production

# ── Public URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROTOCOL=https
NEXT_PUBLIC_ROOT_DOMAIN=bornosoft.site
ROOT_DOMAIN=bornosoft.site
NEXT_PUBLIC_APP_URL=https://bornosoft.site
NEXT_PUBLIC_APP_NAME=BornoLand
NEXT_PUBLIC_ASSET_URL=https://bornosoft.site
NEXT_PUBLIC_SOCKET_URL=https://bornosoft.site

# ── API URLs ──────────────────────────────────────────────────────────────────
# Client-side (browser) — routes through Next.js rewrite proxy (/api/*) or direct port 4000
NEXT_PUBLIC_API_URL=/api

# Server-side (SSR, Server Actions) — standalone on EC2 host is http://127.0.0.1:4000
API_URL=http://127.0.0.1:4000

# ── Auth / session (server-side only — no NEXT_PUBLIC_) ───────────────────────
JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=bornoland.session
NEXTAUTH_URL=https://bornosoft.site
NEXTAUTH_SECRET=change-me-to-a-long-random-string
