# =============================================================================
# BornoLand — Production / Docker Compose environment file
# Fill in real values before deploying.
#
# Usage:
#   cp .env.production.example .env.production   # fill in real values
#   docker compose --env-file .env.production build
#   docker compose --env-file .env.production up -d
#
# NEVER commit this file — it contains production secrets.
# =============================================================================

NODE_ENV=production

# Which env file Compose should load (optional override)
# ENV_FILE=.env.production

# Host port mappings (EC2 security group must allow these)
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4000

# ── Public URLs (browser-facing) ─────────────────────────────────────────────
# EC2 public IP: 3.111.51.117
APP_NAME=BornoLand
APP_URL=http://3.111.51.117:3000
WEB_URL=http://3.111.51.117:3000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_ROOT_DOMAIN=3.111.51.117:3000
NEXT_PUBLIC_APP_URL=http://3.111.51.117:3000
NEXT_PUBLIC_APP_NAME=BornoLand
NEXT_PUBLIC_ASSET_URL=http://3.111.51.117:3000
NEXT_PUBLIC_SOCKET_URL=http://3.111.51.117:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_SUBDOMAIN=true
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BUILDER=true

# Platform apex: browsing by public IP → forward to this storefront slug.
# Uncomment and set to the slug of the default store shown at the bare IP.
# NEXT_PUBLIC_DEFAULT_TENANT=

# Browser → Next.js same-origin /api proxy (Next.js rewrites /api/* → backend)
NEXT_PUBLIC_API_URL=/api

# Server-side SSR / Next.js rewrite target → Docker service name (NOT localhost or EC2 IP)
# Container-to-container traffic stays inside Docker network.
API_URL=http://backend:4000

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000

# Public-facing API URL for callbacks, IPN, webhooks (from outside Docker)
API_PUBLIC_URL=http://3.111.51.117:4000

# CORS — only allow the production frontend origin
CORS_ORIGINS=http://3.111.51.117:3000
ROOT_DOMAIN=3.111.51.117:3000
WILDCARD_DOMAIN=
SESSION_COOKIE_NAME=bornoland.session

# MongoDB Atlas (REQUIRED — do NOT use a local Mongo Docker container)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=bornoland
MONGODB_DB=bornoland

# Auth (REQUIRED — use long random secrets in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Cache revalidation secret
REVALIDATE_SECRET=change-me-revalidate-secret

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://3.111.51.117:4000/auth/google/callback

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="BornoLand <no-reply@example.com>"

# Media / payments (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

# Redis (optional — leave empty if unused)
REDIS_URL=
REDIS_TOKEN=

# AI Shop Builder
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://api.agentrouter.org/v1
AGENT_ROUTER_MODEL=anthropic/claude-3.5-sonnet
