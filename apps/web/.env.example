# =============================================================================
# apps/web/.env.example  —  Example environment file for Next.js frontend
# Copy to .env.local for local development, or .env.production for production:
#   cp .env.example .env.local
#
# DO NOT put real secrets in this file.
# =============================================================================

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=BornoLand

# ── Protocol & Domains ────────────────────────────────────────────────────────
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ── API Base URLs ─────────────────────────────────────────────────────────────
# Server-side (SSR / Server Actions)
API_URL=http://localhost:4000
# Browser-facing (client-side)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── App Feature Flags ─────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_SUBDOMAIN=true
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BUILDER=true

# ── Auth & Session (Server-only secrets: DO NOT prefix with NEXT_PUBLIC_) ──────
JWT_SECRET=your-jwt-secret-here
SESSION_COOKIE_NAME=bornoland.session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# ── Third Party ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
