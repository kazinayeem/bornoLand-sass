# =============================================================================
# apps/api/.env.local  —  Local development overrides
# Loaded by dotenv-flow when NODE_ENV=development (after .env).
# Values here OVERRIDE .env defaults.
#
# NEVER commit this file — it contains real local secrets.
# See .env.example for the template.
# =============================================================================

NODE_ENV=development
PORT=4000

# Public-facing API URL (used for callbacks, IPN, webhooks in local dev)
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Frontend URLs
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# CORS — allow local Next.js dev ports
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# MongoDB Atlas — fill in your connection string
MONGODB_URI=mongodb+srv://miahnayeem470_db_user:zWeSH0PUn3OZ2y4Q@cluster0.va8kngs.mongodb.net/?appName=Cluster0
MONGODB_DB=bornoland

# Auth secrets — use short values for local dev (NOT for production)
JWT_SECRET=testtst
ENCRYPTION_KEY=testtest

