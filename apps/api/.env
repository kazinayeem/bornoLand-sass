# =============================================================================
# apps/api/.env  —  Shared / default configuration (all environments)
# Loaded FIRST by dotenv-flow. Values here are overridden by .env.local (dev)
# or .env.production (prod).
#
# Do NOT put secrets here. Use .env.local or .env.production for those.
# =============================================================================

NODE_ENV=development
PORT=4000

MONGODB_DB=bornoland

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

SESSION_COOKIE_NAME=bornoland.session

SMTP_PORT=587
SMTP_SECURE=false
