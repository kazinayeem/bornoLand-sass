{
  "name": "bornoland",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"corepack pnpm --filter @bornoland/web dev\" \"corepack pnpm --filter @bornoland/api dev\"",
    "build": "turbo run build",
    "start": "concurrently -n web,api -c green,yellow \"corepack pnpm --filter @bornoland/web start\" \"corepack pnpm --filter @bornoland/api start\"",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "clean": "turbo run clean",
    "docker:build": "docker compose --env-file ${ENV_FILE:-.env.production} build",
    "docker:up": "docker compose --env-file ${ENV_FILE:-.env.production} up -d",
    "docker:down": "docker compose --env-file ${ENV_FILE:-.env.production} down",
    "docker:logs": "docker compose --env-file ${ENV_FILE:-.env.production} logs -f",
    "docker:ps": "docker compose --env-file ${ENV_FILE:-.env.production} ps",
    "docker:restart": "docker compose --env-file ${ENV_FILE:-.env.production} up -d --build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "docx": "^9.7.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
