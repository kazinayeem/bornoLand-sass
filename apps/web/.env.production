# =============================================================================
# apps/web/.env.production  —  Production environment configuration
# Loaded by Next.js in production (after .env).
# Values here OVERRIDE .env defaults.
#
# EC2 public IP: 3.111.51.117
#
# NEVER commit this file — use .env.example as the template.
# =============================================================================

NEXT_PUBLIC_APP_ENV=production

# ── Public URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_ROOT_DOMAIN=3.111.51.117:3000
ROOT_DOMAIN=3.111.51.117:3000
NEXT_PUBLIC_APP_URL=http://3.111.51.117:3000
NEXT_PUBLIC_APP_NAME=BornoLand
NEXT_PUBLIC_ASSET_URL=http://3.111.51.117:3000
NEXT_PUBLIC_SOCKET_URL=http://3.111.51.117:3000

# ── API URLs ──────────────────────────────────────────────────────────────────
# Client-side (browser) — routes through Next.js rewrite proxy (/api/*) or direct port 4000
NEXT_PUBLIC_API_URL=/api

# Server-side (SSR, Server Actions) — In Docker, this is http://backend:4000
# When running standalone on EC2 host, this is http://localhost:4000
API_URL=http://3.111.51.117:4000

# ── Auth / session (server-side only — no NEXT_PUBLIC_) ───────────────────────
JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=bornoland.session
NEXTAUTH_URL=http://3.111.51.117:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
