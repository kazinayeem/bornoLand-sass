# =============================================================================
# apps/web/.env.local  —  Local development configuration
# Loaded by Next.js when NODE_ENV=development (after .env).
# Values here OVERRIDE .env defaults.
#
# NEVER commit this file — use .env.example as the template.
# =============================================================================

NEXT_PUBLIC_APP_ENV=development

# ── API URLs ──────────────────────────────────────────────────────────────────
# Server-side (SSR, Server Actions) — call the API directly on localhost
API_URL=http://localhost:4000

# Client-side (browser) — direct to the API port in local dev
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ── Auth / session (server-side only — no NEXT_PUBLIC_) ───────────────────────
JWT_SECRET=testtst
SESSION_COOKIE_NAME=bornoland.session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=testtst
