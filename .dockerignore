# Root .dockerignore — build context is the monorepo root for both images.

.git
.gitignore
.gitattributes

**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/.cache
**/*.tsbuildinfo

# Local env / secrets (Compose injects env at runtime)
.env
.env.*
!.env.production.example
!**/.env.example

# Mobile / unrelated
mobileapp
project_image

# Docs / IDE
DESIGN.md
README.md
**/*.md
.vscode
.idea
.cursor
**/.DS_Store

# Tests
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Deploy examples are not needed inside images
deploy
